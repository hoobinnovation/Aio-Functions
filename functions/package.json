{
  "name": "aio-functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "lint": "eslint . --ext .ts",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "typeorm:migrate": "ts-node -r tsconfig-paths/register ./src/db/run-migrations.ts",
    "typeorm:revert": "ts-node -r tsconfig-paths/register ./src/db/revert-migration.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1",
    "joi": "^17.13.3",
    "mysql2": "^3.11.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
